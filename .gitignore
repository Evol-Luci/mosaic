# OS / editor cruft
.DS_Store
*.swp

# python
__pycache__/
*.pyc

build/

# Dear ImGui writes its saved panel/dock layout here at runtime (mosaic editor).
imgui.ini

# Scene saved to the repo root by a bare `mosaic run`/editor Save at runtime.
scene.json

# Agent / IDE local configs and worktrees
.claude/
.claire/

# Subagent-driven-development scratch (ledgers, briefs, review packages) --
# per-plan working state, not part of the project's own history.
.superpowers/

# Full-resolution HDR environment sources stay local; commit a downsampled 2K copy.
# A 2048x1024 equirect stores as ~4 MB in git and is exactly 1:1 for 512-pixel cubemap
# faces (90 degrees of a 2048-wide equirect is 512 pixels), while the 8K original it
# came from stores as ~43 MB and buys the cubemap nothing.
assets/backgrounds/*.hdr
!assets/backgrounds/*_2k.hdr
